# Puerto de la API
PORT=4000

# Conexión a MongoDB (en Docker Compose el host es "mongo")
MONGODB_URI=mongodb://mongo:27017/team_portal

# Firma de los JWT (cámbiala en cualquier entorno real)
JWT_SECRET=dev-secret-cambiar-en-produccion
JWT_EXPIRES_IN=8h

# Orígenes permitidos (separados por comas) o * para todos
CORS_ORIGIN=*

# Lambda de métricas del dashboard
# Local (Runtime Interface Emulator):
LAMBDA_METRICS_URL=http://lambda-metrics:8080/2015-03-31/functions/function/invocations
# En AWS sería la Function URL, por ejemplo:
# LAMBDA_METRICS_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/

# Carga de cuentas de demostración al arrancar
SEED_ON_START=true
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_USER_PASSWORD=User123!
